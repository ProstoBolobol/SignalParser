<Window x:Class="SignalParser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:local="clr-namespace:SignalParser"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <ScottPlot:WpfPlot x:Name="WpfPlot1" />
        <DockPanel Grid.Column="1" LastChildFill="False">
            <StackPanel DockPanel.Dock="Top" Height="50" Orientation="Horizontal">
                <Label Content="Длина (с):" VerticalAlignment="Top" Margin="10,10,0,0" Height="25" RenderTransformOrigin="0.508,0.293" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" Padding="5,0,5,5" />
                <TextBox x:Name="lengthField" TextWrapping="Wrap" VerticalAlignment="Top" Text="2" Margin="10,10,0,0"
                        Height="20" Width="30" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Padding="0,0,0,1" UseLayoutRounding="False"/>
                <Label Content="Частота (Гц):" VerticalAlignment="Top" Margin="10,10,0,0" Height="25" RenderTransformOrigin="0.508,0.293" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" Padding="5,0,5,5" />
                <TextBox x:Name="frequencyField" TextWrapping="Wrap" VerticalAlignment="Top" Text="200" Margin="10,10,0,0"
                        Height="20" Width="30" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Padding="0,0,0,1" UseLayoutRounding="False"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Height="50" Orientation="Horizontal">
                <Button
                        Content="Sin"
                        HorizontalAlignment="Left"
                        Width="50"
                        Margin="10,10,0,0"
                        VerticalAlignment="Top"
                        Click="Button_Sin"/>
                <Label Content="Период (с):" VerticalAlignment="Top" Margin="10,10,0,0" Height="25" RenderTransformOrigin="0.508,0.293" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" Padding="5,0,5,5" />
                <TextBox x:Name="periodField" TextWrapping="Wrap" VerticalAlignment="Top" Text="1" Margin="10,10,0,0"
                        Height="20" Width="30" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Padding="0,0,0,1" UseLayoutRounding="False" TextChanged="periodField_TextChanged"/>
                <Label Content="Фаза (с):" VerticalAlignment="Top" Margin="10,10,0,0" Height="25" RenderTransformOrigin="0.508,0.293" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" Padding="5,0,5,5" />
                <TextBox x:Name="phaseField" TextWrapping="Wrap" VerticalAlignment="Top" Text="2" Margin="10,10,0,0"
                        Height="20" Width="30" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Padding="0,0,0,1" UseLayoutRounding="False"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Height="50" Orientation="Horizontal">
                <Button
                        Content="Прямая"
                        HorizontalAlignment="Left"
                        Width="50"
                        Margin="10,10,0,0"
                        VerticalAlignment="Top"
                        Click="Button_Line"/>
                <Label Content="k:" VerticalAlignment="Top" Margin="10,10,0,0" Height="25" RenderTransformOrigin="0.508,0.293" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" Padding="5,0,5,5" />
                <TextBox x:Name="kField" TextWrapping="Wrap" VerticalAlignment="Top" Text="1" Margin="10,10,0,0"
                        Height="20" Width="30" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Padding="0,0,0,1" UseLayoutRounding="False"/>
                <Label Content="b:" VerticalAlignment="Top" Margin="10,10,0,0" Height="25" RenderTransformOrigin="0.508,0.293" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" Padding="5,0,5,5" />
                <TextBox x:Name="bField" TextWrapping="Wrap" VerticalAlignment="Top" Text="2" Margin="10,10,0,0"
                        Height="20" Width="30" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Padding="0,0,0,1" UseLayoutRounding="False"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Height="50" Orientation="Horizontal">
                <Button
                        Content="Шум"
                        HorizontalAlignment="Left"
                        Width="50"
                        Margin="10,10,0,0"
                        VerticalAlignment="Top"
                        Click="Button_Noise"/>
                <Label Content="Амплитуда:" VerticalAlignment="Top" Margin="10,10,0,0" Height="25" RenderTransformOrigin="0.508,0.293" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" Padding="5,0,5,5" />
                <TextBox x:Name="amplitudeField" TextWrapping="Wrap" VerticalAlignment="Top" Text="1" Margin="10,10,0,0"
                        Height="20" Width="30" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Padding="0,0,0,1" UseLayoutRounding="False"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Height="50" Orientation="Horizontal">
                <Button
                        Content="Сброс"
                        HorizontalAlignment="Left"
                        Width="45"
                        Margin="10,10,0,0"
                        VerticalAlignment="Top" 
                        Click="Button_Clear"/>
                <Button
                        Content="Удалить"
                        HorizontalAlignment="Left"
                        Width="60"
                        Margin="10,10,0,0"
                        VerticalAlignment="Top" 
                        Click="Button_Delete"/>
                <Button
                        Content="Загрузить"
                        HorizontalAlignment="Left"
                        Width="65"
                        Margin="10,10,0,0"
                        VerticalAlignment="Top" 
                        Click="Button_Reader"/>
                <Button
                        Content="Сохранить"
                        HorizontalAlignment="Left"
                        Width="70"
                        Margin="10,10,0,0"
                        VerticalAlignment="Top" 
                        Click="Button_Writer" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Height="40" Orientation="Horizontal">
                <Button
            Content="Сумма"
            HorizontalAlignment="Left"
            Width="100"
            Margin="10,0,0,0"
            VerticalAlignment="Top" 
            Click="Button_Sum"
            />

                <Button
            Content="Склейка"
            HorizontalAlignment="Left"
            Width="120"
            Margin="10,0,0,0"
            VerticalAlignment="Top"
            Click="Button_Concat"
            />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Height="40" Orientation="Horizontal">
                
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
